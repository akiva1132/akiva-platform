<?akml version="1.0"?>
<!--
    Calculator main layout.

    Dynamic pieces are pulled from bindings at inflate time:
      - {hint}            — the pending operator glyph, or " " when none.
      - {display}         — the number or "Error" string.
      - {display_color}   — typed colour that flips to red in error state.

    Each <Button> carries an `onClick="…"` naming the semantic action
    the Activity should run when the button fires. Rust dispatch keys
    on those action strings (e.g. `ui.was_triggered("equals")`), not on
    `id`, so the ids are free to be renamed for layout/a11y reasons
    without touching src/lib.rs. The action names are the contract —
    keep them stable (or update both sides together).
-->
<VStack padding="16" gap="8" cross="stretch">

    <!--
        Display panel: a Frame layers a subtly-tinted background Rect
        under the HStack so the display area reads as its own surface
        rather than floating on the app background. The Rect carries no
        intrinsic size — it inherits the frame's inner rect (which
        itself follows the HStack's intrinsic height + padding).
    -->
    <Frame>
        <Rect color="@color/display_panel_bg" />
        <HStack gap="12" main="end" cross="center" padding="12 16">
            <!--
                Stone 13.0prep C3 — `@drawable/icon` is the calculator's
                brand mark (apps/calculator/res/drawable/icon.png). The
                renderer paints it from the host-side ImageBitmap cache;
                missing/unregistered ids fall through to magenta so a
                broken @drawable/ ref is loud rather than silent.
            -->
            <Image src="@drawable/icon" w="24" h="24" />
            <Text text="{hint}"    size="22" color="@color/hint_fg" />
            <Text text="{display}" size="48" color="{display_color}" />
        </HStack>
    </Frame>

    <!--
        Keypad: 4 columns × 5 rows, every cell the same size.
        Previously this was a VStack of five HStacks with flex=1 on
        every row and every cell — functionally identical, but the
        intent ("it's a grid") was buried in scaffolding. A single
        <Grid> says what we mean and measures the same.

        Children are laid out row-major, top-left first:
            row 0: C   ±   %   ÷
            row 1: 7   8   9   ×
            row 2: 4   5   6   −
            row 3: 1   2   3   +
            row 4: 0   .   ⌫   =
        The grid itself is `flex=1` so the outer VStack hands it the
        rest of the vertical space after the display panel.
    -->
    <Grid cols="4" rows="5" gap="8" flex="1">
        <Button id="clr"  label="C" onClick="clear" />
        <Button id="sign" label="±" onClick="toggle_sign" />
        <Button id="pct"  label="%" onClick="percent" />
        <Button id="div"  label="÷" onClick="apply_div" />

        <Button id="d7"  label="7" onClick="digit_7" />
        <Button id="d8"  label="8" onClick="digit_8" />
        <Button id="d9"  label="9" onClick="digit_9" />
        <Button id="mul" label="×" onClick="apply_mul" />

        <Button id="d4"  label="4" onClick="digit_4" />
        <Button id="d5"  label="5" onClick="digit_5" />
        <Button id="d6"  label="6" onClick="digit_6" />
        <Button id="sub" label="−" onClick="apply_sub" />

        <Button id="d1"  label="1" onClick="digit_1" />
        <Button id="d2"  label="2" onClick="digit_2" />
        <Button id="d3"  label="3" onClick="digit_3" />
        <Button id="add" label="+" onClick="apply_add" />

        <Button id="d0"   label="0" onClick="digit_0" />
        <Button id="dot"  label="." onClick="input_dot" />
        <Button id="back" label="⌫" onClick="backspace" />
        <Button id="eq"   label="=" onClick="equals" />
    </Grid>
</VStack>
