# Rust
/target/
**/target/
Cargo.lock.bak
*.rs.bk

# Wasm build artifacts
*.wasm.map
/dist/
/build/
# The kernel wasm is built into target/ and copied here by the dev workflow;
# never commit the copy.
runtime/web/akiva-kernel.wasm
# Dev-mode app bundles are rebuilt on demand and copied in by the dev workflow.
runtime/web/dev-apps/*/app.wasm
runtime/web/dev-apps/*/manifest.toml

# wit-bindgen generated (kept in tree if committed; ignore if regenerated)
# bindings/generated/

# Node / web tooling
node_modules/
/runtime/web/node_modules/
npm-debug.log*
yarn-error.log
pnpm-debug.log*
.pnpm-store/
package-lock.json

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Env / local
.env
.env.local
*.log
.codex