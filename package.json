{
  "name": "akiva-platform-runtime",
  "private": true,
  "type": "module",
  "description": "JS-side tests for Akiva's worker runtime (app_registry.js, worker.js). Rust/wasm is driven by cargo; this package covers only the host-side JS seam.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test --config tests/e2e/playwright.config.ts --headed",
    "test:e2e:ui": "playwright test --config tests/e2e/playwright.config.ts --ui",
    "test:e2e:update-snapshots": "playwright test --config tests/e2e/playwright.config.ts --update-snapshots",
    "dev:open": "node tests/e2e/open.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/pngjs": "^6.0.5",
    "happy-dom": "^20.9.0",
    "pngjs": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
