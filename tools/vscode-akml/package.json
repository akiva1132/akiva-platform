{
  "name": "akml-language",
  "displayName": "AKML Language Support",
  "description": "Syntax highlighting and editor support for Akiva Markup Language (.akml)",
  "version": "0.0.1",
  "publisher": "akiva-platform",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "akml",
    "akiva",
    "xml",
    "markup"
  ],
  "contributes": {
    "languages": [
      {
        "id": "akml",
        "aliases": [
          "AKML",
          "Akiva Markup Language"
        ],
        "extensions": [
          ".akml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "akml",
        "scopeName": "text.akml",
        "path": "./syntaxes/akml.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "akml",
        "path": "./snippets/akml.code-snippets"
      }
    ]
  }
}
